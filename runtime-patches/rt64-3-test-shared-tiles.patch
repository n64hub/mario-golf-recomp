+                        for (uint32_t t = 0; t < call.tileCount; t++) {
+                            if ((call.tileIndex + t) < tileUsers.size()) {
+                                tileUsers[call.tileIndex + t]++;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        auto askSlide = [&](uint32_t tileIndex, float moveS, float moveT, float scaleS, float scaleT) {
+            if (tileIndex >= tileAsks.size()) {
+                return;
+            }
+
+            const TileSlide slide = { moveS, moveT, scaleS, scaleT };
